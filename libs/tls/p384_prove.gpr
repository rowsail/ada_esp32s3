--  Native project for SPARK-proving P384: the same two generics P256 proves --
--  ECC_Bignum's modular arithmetic and ECC_Curve's Jacobian point arithmetic --
--  but at TWELVE limbs, plus P-384's own From_BE and ECDSA Verify.
--
--  A separate project because GNATprove proves generic INSTANCES, not generics:
--  P256's run discharges the eight-limb instantiation and says nothing about
--  the twelve-limb one.  The bodies are shared, the obligations are not.
--
--  No SPARKNaCl here (P-384 is verification only -- no signing, so no hashing
--  glue) and no target layer, so it proves natively alongside P256 in
--  book/prove/prove.sh's fast pass.  No main.
project P384_Prove is
   for Source_Dirs use ("src");
   for Object_Dir use "obj-p384-prove";
   for Source_Files use
     ("p384.ads", "p384.adb",
      "ecc_bignum.ads", "ecc_bignum.adb",
      "ecc_curve.ads", "ecc_curve.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnata", "-gnat2022");
   end Compiler;
end P384_Prove;
