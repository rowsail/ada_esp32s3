--  Native project for SPARK-proving the handshake-flight walk.
--
--  This is the first code a hostile server reaches: the bytes are its bytes
--  and every offset the walk computes comes from lengths it chose.  Proving it
--  covers every input, which a table of malformed vectors cannot.  The parent
--  spec is types only; its body (sockets, the AES accelerator, the key
--  schedule) is not needed and is not analysed.  Run gnatprove at --level=2.
project TLS_Scan_Prove is
   for Source_Dirs use
     ("src", external ("ADA_ESP32S3", "../..") & "/libs/esp32s3_hal/src");
   for Object_Dir use "obj-scan-prove";
   for Source_Files use
     ("tls_client.ads", "tls_client-scan.ads", "tls_client-scan.adb",
      "x509.ads", "esp32s3.ads");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnata", "-gnat2022");
   end Compiler;
end TLS_Scan_Prove;
