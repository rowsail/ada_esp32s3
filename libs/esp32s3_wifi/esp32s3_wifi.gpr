--  ESP32-S3 Wi-Fi driver (ESP32S3.WiFi.*).  Pure-Ada OS adapter / PHY / interrupt
--  glue and software network stack that drives the radio through Espressif's
--  binary lower-MAC + PHY libraries (fetched, not committed -- see blobs/ and
--  tools/fetch-wifi-blobs.sh).  Wi-Fi is surfaced to the network stack as a
--  Net_Device (a NIC).  Child units of ESP32S3, so it withs the HAL.  Built
--  cross only, against the embedded (Jorvik) runtime; each example's bare-boot
--  image adds the Wi-Fi blobs to its vendor link.  See BRINGUP.md.
with "../../crates/esp32s3_rts/esp32s3_rts.gpr";
with "esp32s3_hal.gpr";

project Esp32s3_Wifi is
   --  Target + Runtime, like every other library here.  Without them this
   --  project builds against whatever the invoking tree defaults to -- fine
   --  while it was only ever built inside an example (whose own .gpr sets
   --  both), and wrong the moment anything builds it on its own, which is
   --  exactly what `./x test lib` does.
   for Target use "xtensa-esp32-elf";
   for Runtime ("Ada") use Esp32s3_Rts.Runtime_Path;
   --  Needs an exception-capable profile (the OS adapter and the software TCP
   --  stack use finalization and the secondary stack), so it defaults to
   --  embedded rather than inheriting the runtime crate's light-tasking.
   type Profile_Kind is ("embedded", "full");
   Profile : Profile_Kind := external ("ESP32S3_RTS_PROFILE", "embedded");

   for Source_Dirs use ("src");
   --  Per-profile, for the reason the HAL gives: one object directory shared
   --  across profiles goes stale in ways that only show up at link time.
   for Object_Dir use "obj-" & Profile;

   package Compiler is
      --  The same warning set as the HAL and libs/tls, and held there the same
      --  way: `./x test lib` builds this library on every profile it supports
      --  with warnings as failures.
      --
      --  The 54 findings that used to block this were not what the earlier note
      --  here guessed.  Most were the OS adapter's named halt-stubs, and they
      --  were not blob-facing at all: every slot they stood in for had since
      --  gained a real implementation, so they were unreachable scaffolding and
      --  are gone.  What DID need marking rather than deleting was the
      --  supplicant's reverse-engineered ABI -- imports and key-flag constants
      --  kept as documentation -- which now carries pragma Unreferenced.
      for Default_Switches ("Ada") use
        ("-g", "-O2", "-gnat2022", "-gnatwa", "-gnatwJ", "-gnatw.V");
   end Compiler;
end Esp32s3_Wifi;
