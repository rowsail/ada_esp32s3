--  Reusable ESP32-S3 HAL: hand-written peripheral drivers (ESP32S3.*) over the
--  svd2ada-generated register layer (ESP32S3_Registers.*).
--
--  Use it from ANY project with one line -- by name (resolved via GPR_PROJECT_PATH,
--  set by the SDK's export.sh / bare_build) for standalone projects:
--
--     with "esp32s3_hal.gpr";          -- then in your code:  with ESP32S3.GPIO;
--
--  or by relative path from an in-repo example (so the Ada Language Server resolves
--  it with no environment):
--
--     with "../../libs/esp32s3_hal/esp32s3_hal.gpr";
--
--  Its units compile against the SAME runtime + profile as the consumer.
--
--  BEFORE BUILDING THIS PROJECT DIRECTLY, source the SDK's export.sh.  The
--  Xtensa back end reads XTENSA_GNU_CONFIG for the core configuration, and
--  endianness is part of it: with the variable unset the compiler does not
--  fail, it emits BIG-endian objects.  Object_Dir below is shared by every
--  consumer of a profile, so one such build poisons the directory and every
--  later example fails at LINK time with "compiled for a big endian system and
--  target is little endian" -- a message nowhere near the cause.  export.sh
--  sets it (as does each example's build.sh via bare_build.sh); CI builds all
--  three profiles so a regression here surfaces immediately.
--
--  PROFILE: these drivers TARGET the `embedded` profile, where full exception
--  propagation lets the contracts (the GPIO valid-pin predicate, enabled by
--  -gnata below) raise a catchable exception, and lets the task-safe SPI/I2C/UART
--  Session be a controlled type that auto-releases its host on scope exit.
--
--  The lock-free drivers (GPIO, RNG, Temperature) compile under ALL profiles,
--  including light-tasking.  The RAII-handle drivers (SPI, I2C, UART, GDMA and
--  MCPWM) use finalization (a controlled Session / Channel / Capture handle),
--  which light-tasking forbids (No_Finalization).  Which units a profile sees is
--  decided by SOURCE DIRECTORY, not by an exclusion list: light-tasking sees
--  "src" alone, embedded/full see "src/**".  See the Source_Dirs case below for
--  the directory map and for which one a new file belongs in.
with "../../crates/esp32s3_rts/esp32s3_rts.gpr";

project ESP32S3_HAL is
   --  The profile MUST match the runtime crate's default (esp32s3_rts.gpr also
   --  defaults to "light-tasking") so an unset ESP32S3_RTS_PROFILE picks the same
   --  profile for both; a driver-using project selects "embedded" by exporting it
   --  (its build.sh does, e.g. esp32s3_i2c_loopback).  The drivers TARGET embedded
   --  -- where -gnata's contract checks raise catchable exceptions -- but still
   --  compile under light-tasking (see the Compiler case below).
   type Profile_Kind is ("light-tasking", "embedded", "full");
   Profile : Profile_Kind := external ("ESP32S3_RTS_PROFILE", "light-tasking");

   for Target use "xtensa-esp32-elf";
   for Runtime ("Ada") use Esp32s3_Rts.Runtime_Path;
   --  Per-profile object dir: the HAL is shared across consumers AND profiles, so
   --  keying obj by profile avoids cross-profile staleness in the shared tree.
   for Object_Dir use "obj-" & Profile;

   --  PROFILE SCOPING IS BY SOURCE DIRECTORY, NOT BY AN EXCLUSION LIST.
   --
   --  Some drivers use controlled types (finalization) for RAII handles -- the
   --  SPI/I2C/UART Session, the GDMA Channel, the MCPWM Channel/Capture -- and
   --  the filesystems additionally use exceptions and the secondary stack.
   --  Finalization is unavailable under light-tasking's No_Finalization, so
   --  those units cannot be part of a light-tasking build at all.
   --
   --  This used to be spelled as a ~130-entry Excluded_Source_Files blacklist,
   --  which meant a new driver was IN the light-tasking build until somebody
   --  remembered to exclude it -- and the list drifted (children of excluded
   --  parents, and whole units, were never added, so the library stopped
   --  building under its own default profile).  The directories below invert
   --  that: light-tasking sees exactly "src", and a unit that needs more is
   --  placed in a subdirectory light-tasking never looks in.  Adding a file
   --  now defaults to SAFE.
   --
   --    src/              lock-free / pure-logic core: every profile
   --    src/peripherals/  on-chip drivers with an RAII Session/Channel handle
   --    src/devices/      off-chip devices reached over those (sensors, panels,
   --                      expanders, flash, codecs, GPS, SD-over-SPI)
   --    src/net/          Net_Devices + the W5500 NIC, the GNAT.Sockets facade
   --                      and everything on it (DNS, NTP, FTP, Modbus)
   --    src/text_io/      ESP32S3.Text_IO (finalization + the ext4 filesystem)
   --    src/eeprom/  src/fram/  src/ext4/  src/fat16/  src/esp_loader/
   --
   --  If you add a source directory under src/, embedded/full pick it up with
   --  no edit here ("src/**" is recursive); light-tasking never will, which is
   --  the safe default.  CI builds all three profiles, so a unit placed in the
   --  wrong directory fails immediately instead of silently.
   case Profile is
      when "light-tasking" =>
         for Source_Dirs use ("src", "svd");
      when "embedded" | "full" =>
         for Source_Dirs use ("src/**", "svd");
   end case;

   package Compiler is
      --  Reject GNAT stack trampolines ('Access of an up-level-capturing nested
      --  subprogram): they are emitted on this target's non-executable stack and
      --  fault silently when called.  See no_dynamic_code.adc.
      for Local_Configuration_Pragmas use "no_dynamic_code.adc";

      --  -gnata turns on the contract checks (e.g. the GPIO valid-pin predicate)
      --  at run time -- but only under the exception-capable profiles.  Under
      --  light-tasking the assertion path would drag in the DWARF unwinder + a
      --  libc (malloc/free/abort) that the heap-less profile doesn't link, so it
      --  is omitted there (a light-tasking build keeps the compile-time predicate
      --  warning but no run-time check).
      --  WARNINGS ARE ON, AND THE HAL BUILDS CLEAN UNDER THEM.  This used to be
      --  bare "-O2 -g", which let real defects sit unseen: unused with clauses,
      --  assignments overwritten before they were ever read, and variables read
      --  but never assigned.  CI fails the build on any warning, so the clean
      --  state is the enforced state -- if you add a warning, fix it or justify
      --  it with a scoped pragma Warnings (Off, ...) that says why.
      --
      --  Two of -gnatwa's warnings are turned back off, deliberately:
      --
      --    -gnatwJ  the obsolescent-() array-aggregate note.  Under -gnat2022
      --             GNAT suggests [...] for every (...) aggregate: 355 hits,
      --             all style, none a defect.  (The host test projects have
      --             always passed -gnatwJ for the same reason.)
      --
      --    -gnatw.V the "reverse bit order in machine scalar" note.  It fires
      --             ~8,500 times on svd/, the machine-generated register layer,
      --             where the layout is dictated by silicon rather than chosen
      --             -- and those encodings are checked for real by the
      --             repclause_host and endian_host suites.  Left on, it buries
      --             every warning that does mean something.
      Warning_Switches := ("-gnatwa", "-gnatwJ", "-gnatw.V");

      case Profile is
         when "light-tasking" =>
            --  -gnatw.X additionally, for this profile only.  Under
            --  No_Exception_Propagation, -gnatwa reports every implicit runtime
            --  check that could reach Last_Chance_Handler -- 1,473 of them, one
            --  per array index and range check in the library, which is what the
            --  restriction MEANS rather than anything to fix.  The same sources
            --  under embedded/full (where the checks are catchable) warn zero
            --  times, so nothing is hidden here that the other two profiles do
            --  not already cover.
            for Default_Switches ("Ada") use
              ("-O2", "-g") & Warning_Switches & ("-gnatw.X");
         when "embedded" | "full" =>
            --  -gnat2022: the ext4 filesystem uses Ada 2022 container ('[...]')
            --  aggregates.
            for Default_Switches ("Ada") use
              ("-O2", "-g", "-gnata", "-gnat2022") & Warning_Switches;
      end case;
   end Compiler;
end ESP32S3_HAL;
