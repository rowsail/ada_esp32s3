--  Native (x86) host test harness for the pure-Ada FAT16 reader / formatter.
--  Builds the same sources the firmware compiles against a file-backed block
--  device, so the filesystem can be exercised and cross-checked with the host's
--  own dosfstools.  See README.md.
--
--  Source_Files is an explicit whitelist (not an exclude): only the portable
--  units are compiled, so new on-target HAL drivers never affect this build.
project Fat16_Host is
   for Source_Dirs use (".", "../../src", "../../src/ext4", "../../src/fat16");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("fat16_test.adb");
   for Source_Files use
     ("fat16_test.adb",
      "esp32s3.ads",
      "esp32s3-block_dev.ads",
      "esp32s3-block_dev.adb",
      "esp32s3-fat16.ads",
      "esp32s3-fat16.adb",
      "esp32s3-fat16-mkfs.ads",
      "esp32s3-fat16-mkfs.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-O0", "-gnat2022", "-gnata", "-gnatwa", "-gnatwJ");
   end Compiler;
end Fat16_Host;
