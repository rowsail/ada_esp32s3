--  Native project for SPARK-proving the pure count->millivolts conversion of
--  the TLV2556 ADC driver (Millivolts, carrying a Post) plus the CFGR2_Nibble
--  reference selector.  The SPI/GDMA transfer (Cycle / Read / Initialize) is
--  hardware and stays unmarked (SPARK_Mode off).  Host-portable: the only
--  generated register specs here are the two pad banks ESP32S3.GPIO's SPARK
--  contracts name, which are plain Interfaces/System.  No main.
project TLV2556_Prove is
   for Source_Dirs use ("../../src", "../../svd");
   for Object_Dir use "obj";
   for Source_Files use
     ("esp32s3.ads",
      "esp32s3_registers.ads",
      "esp32s3_registers-gpio.ads",
      "esp32s3_registers-io_mux.ads",
      "esp32s3-gpio.ads",
      "esp32s3-gdma.ads",
      "esp32s3-spi.ads",
      "esp32s3-tlv2556.ads",
      "esp32s3-tlv2556.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnata", "-gnat2022");
   end Compiler;
end TLV2556_Prove;
