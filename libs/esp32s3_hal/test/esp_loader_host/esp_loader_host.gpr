--  Native (x86) host harness for the ESP32 serial-bootloader protocol.  The
--  protocol is transport-agnostic, so the same sources the firmware compiles
--  run here against a simulated ROM on the other end of a pipe.  See README.md.
--
--  Source_Files is an explicit whitelist (not an exclude): only the portable
--  units are compiled, so new on-target HAL drivers never affect this build.
project Esp_Loader_Host is
   for Source_Dirs use (".", "../../src", "../../src/esp_loader");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("esp_loader_test.adb");
   for Source_Files use
     ("esp_loader_test.adb",
      "esp32s3.ads",
      "esp32s3-esp_loader.ads",
      "esp32s3-esp_loader.adb",
      "esp32s3-esp_loader-auto_reset.ads",
      "esp32s3-esp_loader-auto_reset.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-O0", "-gnat2022", "-gnata", "-gnatwa", "-gnatwJ");
   end Compiler;
end Esp_Loader_Host;
