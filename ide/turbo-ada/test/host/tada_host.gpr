--  Host tests for Turbo Ada's non-screen logic: the text buffer and its
--  undo, the compiler-message parser, the syntax classifier, and project
--  detection with its command templates.

project Tada_Host is
   for Languages use ("Ada", "C");
   for Source_Dirs use (".", "../../src");
   for Excluded_Source_Files use ("tada.adb");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("tada_host.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-g", "-gnatwa", "-gnatwJ");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;
end Tada_Host;
