# ---- Build artifacts ----
#  Host-test executables: each libs/*/test/<name>/ builds its binary in place
#  (run.sh does), and one of them was committed once -- 1.8 MB of ELF whose
#  source was not even in this repo.  Ignore them by construction.
/libs/*/test/*/*_host
/libs/*/test/*/*_test
/libs/*/test/*/gnatprove/
**/build/
**/.objs/
**/.ada_build/
**/obj/
**/obj-*/
*.o
*.ali
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
# packaged images + linker maps + the bare-boot intermediate dir (regenerated by ./x build)
/examples/*/app.bin
/examples/*/app.elf
/examples/*/app.map
/examples/*/.noidf/
/examples/*/config/
/examples/*/.custom_build/
/examples/common/bare/bootloader/boot.elf
/examples/common/bare/bootloader/boot.map
/examples/common/bare/bootloader/bootloader.bin
**/__pycache__/

# ---- Real Wi-Fi credentials (the .template beside them IS tracked) ----
#  Repo-wide, not per-example: a new Wi-Fi example must not be able to leak an
#  SSID/PSK by forgetting to add its own rule.
**/wifi_credentials.ads

# ---- Generated native runtime (regenerate via hwtest/native/main/build_ada.sh) ----
/hwtest/native/rts/

# ---- Downloaded ACATS suite (large; not redistributed in this repo) ----
/ACATS42/

# ---- Regenerated ACATS filter work dir ----
/ACATS/work/

# ---- ACATS on-target runner scratch (regenerated by build_acats_runner.sh) ----
/ACATS/target/_build/
/ACATS/target/_probe/
/ACATS/target/_sweep/
**/.acats_build/

# ---- Per-example VS Code cruft (the ESP-IDF extension drops its own config here);
#      the project's real VS Code config is the repo-root .vscode/ ----
examples/*/.vscode/
b~*
