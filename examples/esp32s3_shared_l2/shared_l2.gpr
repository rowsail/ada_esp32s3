with "../../crates/esp32s3_rts/esp32s3_rts.gpr";
with "../../libs/esp32s3_hal/esp32s3_hal.gpr";   --  ESP32S3.TWAI + svd register layer

--  Two drivers on ONE level-2 interrupt: buffered UART RX and TWAI RX, both
--  routed to CPU_INT 19 and both serviced through ESP32S3.Shared_L2.  Before
--  the shared dispatcher this image could not exist -- the second
--  Attach_Handler on the slot raised Program_Error at elaboration, so it
--  boot-looped.
project Shared_L2_Demo is
   for Target use "xtensa-esp32-elf";
   for Runtime ("Ada") use Esp32s3_Rts.Runtime_Path;
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main.adb");
   package Builder is
      for Executable ("main.adb") use "ada_app.o";
   end Builder;
   package Binder is
      for Switches ("Ada") use ("-D8k", "-Q2", "-Mada_main");
   end Binder;
   package Compiler is
      for Switches ("Ada") use ("-O2", "-g", "-gnata");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-r", "-nostdlib");
   end Linker;
end Shared_L2_Demo;
