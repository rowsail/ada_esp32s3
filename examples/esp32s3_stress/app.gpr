with "../../crates/esp32s3_rts/esp32s3_rts.gpr";

--  RTS stress suite (see README.md): a randomized tiny-delay storm across
--  both cores plus cross-core suspension-object and entry ping-pong pairs,
--  all publishing heartbeats that an on-board monitor task (and the host
--  check.sh over JTAG) watch for stalls.
project App is
   for Target use "xtensa-esp32-elf";
   for Runtime ("Ada") use Esp32s3_Rts.Runtime_Path;
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "ada_app.o";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-D8k", "-Q2", "-Mada_main");
   end Binder;

   package Compiler is
      for Switches ("Ada") use ("-O2", "-g", "-gnata");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-r", "-nostdlib");
   end Linker;
end App;
