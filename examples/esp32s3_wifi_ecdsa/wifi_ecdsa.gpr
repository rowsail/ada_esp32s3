--  Wi-Fi ECDSA example: authenticates an all-ECDSA certificate chain over pure
--  Ada TLS 1.3 on the software TCP stack.  Same project shape as the wifi_tls
--  example -- runtime/HAL/TLS from ADA_ESP32S3, the Wi-Fi driver from this
--  repo's libs/esp32s3_wifi -- but this one exercises P256 and P384 rather than
--  the RSA path.
with "esp32s3_rts.gpr";   --  runtime crate (from ADA_ESP32S3, via GPR_PROJECT_PATH)
with "esp32s3_hal.gpr";   --  ESP32S3.Log/RNG + DNS_Client/NTP_Client (ADA_ESP32S3)
with "tls.gpr";           --  pure-Ada TLS 1.3 + X509 + Chain_Verify (ADA_ESP32S3)
with "esp32s3_wifi.gpr";  --  the Wi-Fi driver (this repo: libs/esp32s3_wifi)

project Wifi_Ecdsa is
   for Target use "xtensa-esp32-elf";
   for Runtime ("Ada") use Esp32s3_Rts.Runtime_Path;
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "ada_app.o";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-D8k", "-Q2", "-Mada_main");
   end Binder;

   package Compiler is
      for Switches ("Ada") use ("-O2", "-g");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-r", "-nostdlib");
   end Linker;
end Wifi_Ecdsa;
